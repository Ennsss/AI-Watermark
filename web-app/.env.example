# Web App Environment Configuration
# Copy this to .env and update values as needed

# API Configuration
REACT_APP_API_URL=http://localhost:8000

# Backend Configuration  
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4

# Image Processing
MAX_IMAGE_SIZE=2048
MAX_FILE_SIZE_MB=50

# Watermarking Parameters
DEFAULT_DELTA=16
DWT_LEVEL=2
WAVELET=haar
